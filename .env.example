# ============================================================
# Crop Health Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://crophealth:crophealth@localhost:5432/crophealth
# For SQLite (dev only, no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///./crophealth.db

POSTGRES_USER=crophealth
POSTGRES_PASSWORD=crophealth
POSTGRES_DB=crophealth

# --- API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# --- LLM Provider ---
# Options: ollama | deepseek
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Lightweight alternative: llama3.2

# DeepSeek (optional — only if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=huggingface
# Ollama alternative: nomic-embed-text / EMBEDDING_PROVIDER=ollama

# --- ChromaDB ---
CHROMA_PERSIST_PATH=./chroma_db

# --- Computer Vision ---
CV_CONFIDENCE_THRESHOLD=0.65

# --- File Storage ---
UPLOADS_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# --- Crops System ---
CROPS_DIRECTORY=./crops

# --- Simulation ---
SIMULATION_MODE=true
